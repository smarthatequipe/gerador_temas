<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerador de Temas</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Gerador de Temas</h1>
            <p>Sistema para geração e gerenciamento de templates</p>
        </header>

        <main>
            <section class="actions">
                <a href="/templates/new" class="btn btn-primary">
                    Criar Novo Template
                </a>
                <a href="/templates" class="btn btn-secondary">
                    Ver Templates Existentes
                </a>
            </section>

            <section class="features">
                <h2>Funcionalidades</h2>
                <ul>
                    <li>Geração automática de templates</li>
                    <li>Componentes modulares</li>
                    <li>Preview em tempo real</li>
                    <li>Edição de componentes</li>
                    <li>Exportação de templates</li>
                </ul>
            </section>
        </main>

        <footer>
            <p>&copy; 2024 Gerador de Temas. Todos os direitos reservados.</p>
        </footer>
    </div>

    <script src="/js/main.js"></script>
</body>
</html> 